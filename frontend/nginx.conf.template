# Rendered by the nginx image's envsubst at startup (templates/*.template).
# Only ${UPPERCASE_ENV} placeholders are substituted; nginx runtime vars
# ($host, $http_upgrade, …) pass through untouched.
#
# Local compose defaults (set in the Dockerfile): PORT=80, API_HOST=api,
# API_PORT=8000, DNS_RESOLVER="127.0.0.11 ipv6=off".
# Railway: PORT is injected; set API_HOST=<api private domain>,
# DNS_RESOLVER="[fd12::10]" (Railway's private-network DNS, IPv6).
server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Behind Railway's TLS proxy, nginx's default absolute redirects leak the
    # internal scheme/port (http://host:8080/landing/), which the edge doesn't
    # serve. Relative redirects survive any proxy.
    absolute_redirect off;

    location /api/ {
        # Re-resolve the upstream per request: a static proxy_pass caches the
        # api's IP at startup and serves 502s after every api redeploy.
        resolver ${DNS_RESOLVER} valid=10s;
        set $api_upstream http://${API_HOST}:${API_PORT};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
